# Copy to .env for local `netlify dev`, and set the same keys in the Netlify UI
# under Site configuration -> Environment variables for the deployed site.

# --- LLM gateway -----------------------------------------------------------
# An OpenAI-compatible base URL. 9Router exposes one on /v1.
#
# IMPORTANT: this is resolved by a function running in Netlify's cloud, so it
# must be reachable from the internet. A 9Router on your own laptop is not --
# for that, use Direct mode in the app's Settings, which calls the gateway from
# your browser instead.
GATEWAY_BASE_URL=http://localhost:20128/v1

# The API key from the 9Router dashboard home page.
GATEWAY_API_KEY=

# Model used when a chat has not picked one yet.
DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# Cap on tokens per reply. Netlify allows a streaming function 60 seconds, so
# a very high value here can end in a truncated answer.
MAX_TOKENS=4096

# Ordered fallback chain, comma separated. When the chosen model errors or is
# rate limited, the gateway walks this list and serves from the first model
# that answers -- 9Router's tiered behaviour, on a gateway without it built in.
# Put free models last so they are the safety net, not the default.
#
# Rides on OpenRouter's `models` field, and is omitted from the request
# entirely when blank, so a gateway that does not understand it never sees it.
# The reply is labelled with whichever model actually served it.
FALLBACK_MODELS=

# Let a visitor supply their own key from the Settings dialog (header only,
# never the base URL unless you opt in below).
ALLOW_CLIENT_KEY=true

# Off by default: allowing an arbitrary base URL turns the function into an
# open request proxy for anyone who finds it.
ALLOW_CLIENT_BASE_URL=false

# --- accounts (optional) ---------------------------------------------------
# Leave DATABASE_URL blank and the whole site still works -- sign-in simply
# reports that it is switched off. Chat never requires an account.
#
# Use a POOLED Postgres connection string (Netlify DB and Neon both give you
# one); serverless functions exhaust direct connections quickly.
DATABASE_URL=

# Any long random string. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's public origin. Netlify sets URL automatically on deploys, so this
# is mainly for local development.
BETTER_AUTH_URL=http://localhost:8888

# Extra origins allowed to hold a session, comma separated.
TRUSTED_ORIGINS=

# --- Google sign-in (optional) ---------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Authorised redirect URI: https://<your-site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
