# Copy to .env for local `netlify dev`, and set the same keys in the Netlify UI
# under Site configuration -> Environment variables for the deployed site.

# --- LLM gateway -----------------------------------------------------------
# Any OpenAI-compatible base URL. Visitors never see or configure this: the
# server holds one key and routes every request itself.
GATEWAY_BASE_URL=https://openrouter.ai/api/v1

# A key for that gateway. Without it the chat reports itself as unavailable.
#
# NOTE: this key pays for every visitor, and there is no sign-in gate on chat.
# Put a spend limit on it before the URL goes anywhere public.
GATEWAY_API_KEY=

# Model used for every request. `openrouter/auto` lets the gateway pick one
# per prompt; a concrete id pins it instead.
DEFAULT_MODEL=openrouter/auto

# Cap on tokens per reply. Netlify allows a streaming function 60 seconds, so
# a very high value here can end in a truncated answer.
MAX_TOKENS=4096

# Ordered fallback chain, comma separated, tried when the chosen model errors
# or is rate limited. Put free models last so they are the safety net.
#
# Ignored when DEFAULT_MODEL is an auto-router, which does its own routing.
# OpenRouter accepts at most three models in total, and the code truncates
# rather than letting a longer list fail the request with a 400.
FALLBACK_MODELS=

# --- accounts (optional) ---------------------------------------------------
# Leave DATABASE_URL blank and the whole site still works -- sign-in simply
# reports that it is switched off. Chat never requires an account.
#
# Setting it turns on two things at once: accounts, and chat history that
# follows a signed-in user between devices. Guests are unaffected either way.
#
# Use a POOLED Postgres connection string (Neon gives you one); serverless
# functions exhaust direct connections quickly.
#
# No migration step: the functions create their own tables on first use. For a
# local database you hold the URL to, `npm run auth:migrate` does it up front.
DATABASE_URL=

# Any long random string. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's public origin. Netlify sets URL automatically on deploys, so this
# is mainly for local development.
BETTER_AUTH_URL=http://localhost:8888

# Extra origins allowed to hold a session, comma separated.
TRUSTED_ORIGINS=

# --- Google sign-in (optional) ---------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Authorised redirect URI: https://<your-site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
